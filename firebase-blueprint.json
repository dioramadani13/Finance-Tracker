{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user profile and financial settings stored per Firebase UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address",
          "maxLength": 200
        },
        "displayName": {
          "type": "string",
          "description": "Display name",
          "maxLength": 80
        },
        "initialBalance": {
          "type": "number",
          "description": "Initial balance used to compute remaining balance"
        },
        "currency": {
          "type": "string",
          "enum": ["IDR", "USD", "SGD", "MYR"],
          "maxLength": 8
        },
        "monthlyBudget": {
          "type": "number",
          "description": "Monthly expense budget target"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "initialBalance",
        "currency",
        "monthlyBudget",
        "createdAt",
        "updatedAt"
      ]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Unified income or expense transaction belonging to a user.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["income", "expense"],
          "maxLength": 16
        },
        "amount": {
          "type": "number"
        },
        "category": {
          "type": "string",
          "description": "Manual transaction category",
          "minLength": 1,
          "maxLength": 40
        },
        "note": {
          "type": "string",
          "maxLength": 300
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "subType": {
          "type": "string",
          "enum": ["", "Tabungan", "Investasi"],
          "maxLength": 20
        },
        "paymentMethod": {
          "type": "string",
          "enum": [
            "",
            "Tunai",
            "Transfer Bank",
            "QRIS",
            "E-Wallet",
            "Kartu Debit",
            "Kartu Kredit"
          ],
          "maxLength": 32
        },
        "externalId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "amount",
        "category",
        "note",
        "date",
        "title",
        "subType",
        "paymentMethod",
        "externalId",
        "userId",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "User profile and financial configuration owned strictly by userId"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": {
        "$ref": "#/entities/Transaction"
      },
      "description": "Income and expense transactions owned strictly by parent userId"
    }
  }
}
